<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>

    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.DisableIPv6" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <ProjectReference Include="../GlassDock.Core/GlassDock.Core.csproj" />
    <ProjectReference Include="../GlassDock.Windows/GlassDock.Windows.csproj" />
    <ProjectReference Include="../GlassDock.Watchdog/GlassDock.Watchdog.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyBuiltRecoveryHelper" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- ProjectReference builds the helper, but does not copy an executable reference.
         Resolve its real output path so VS/CLI launches cannot use an old Recovery payload. -->
    <MSBuild Projects="../GlassDock.Watchdog/GlassDock.Watchdog.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="BuiltRecoveryTarget" />
    </MSBuild>
    <PropertyGroup>
      <BuiltRecoveryDirectory>%(BuiltRecoveryTarget.RootDir)%(BuiltRecoveryTarget.Directory)</BuiltRecoveryDirectory>
    </PropertyGroup>
    <ItemGroup>
      <BuiltRecoveryFiles Include="$(BuiltRecoveryDirectory)/*" />
      <BuiltRecoveryRuntimeFiles Include="$(BuiltRecoveryDirectory)/runtimes/**/*" />
    </ItemGroup>
    <Error Condition="!Exists('$(BuiltRecoveryDirectory)/GlassDock.Watchdog.exe')" Text="The current watchdog build is missing; refusing to leave a stale Recovery helper." />
    <Copy SourceFiles="@(BuiltRecoveryFiles)" DestinationFiles="@(BuiltRecoveryFiles->'$(TargetDir)Recovery/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BuiltRecoveryRuntimeFiles)" DestinationFiles="@(BuiltRecoveryRuntimeFiles->'$(TargetDir)Recovery/runtimes/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRecoveryHelper" AfterTargets="Publish">
    <ItemGroup>
      <RecoveryFiles Include="../GlassDock.Watchdog/bin/$(Configuration)/net10.0-windows10.0.26100.0/$(RuntimeIdentifier)/**/*" />
    </ItemGroup>

    <Copy SourceFiles="@(RecoveryFiles)" DestinationFiles="@(RecoveryFiles->'$(PublishDir)Recovery/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(RecoveryFiles)' != ''" />
  </Target>

  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)GlassDock.App.pri" DestinationFiles="$(PublishDir)GlassDock.App.pri" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)GlassDock.App.pri')" />
  </Target>
</Project>