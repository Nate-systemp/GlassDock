<UserControl
    x:Class="GlassDock.App.Controls.GlassSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="ShadowHost" IsHitTestVisible="False"/>
        <Rectangle x:Name="MaterialShape" IsHitTestVisible="False"/>
        <Rectangle x:Name="LightingShape" IsHitTestVisible="False"/>
        <Border x:Name="Rim" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#40FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#B8D7F7FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
        <ContentPresenter x:Name="SurfaceContent" Margin="36"/>
    </Grid>
</UserControl>
