<Window
    x:Class="GlassDock.App.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#10141C" RequestedTheme="Dark">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="36,30,36,28" Spacing="22">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="GlassDock Settings"
                        FontSize="30"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        Text="Adjust how the dock rests and responds when the pointer leaves."
                        FontSize="14"
                        Foreground="#AEB7C6"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <Border
                    Padding="24,22"
                    CornerRadius="18"
                    Background="#C91A202B"
                    BorderBrush="#344052"
                    BorderThickness="1">
                    <StackPanel Spacing="22">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Dock behavior" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Changes apply to the running dock after you select Apply."
                                Foreground="#99A5B7"
                                FontSize="12"/>
                        </StackPanel>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Material" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="GlassMaterialModeBox" Grid.Column="1" Header="Style"
                                SelectionChanged="MaterialModeChanged"
                                AutomationProperties.Name="Main dock material style">
                                <ComboBoxItem Content="Frosted"/>
                                <ComboBoxItem Content="Acrylic"/>
                                <ComboBoxItem Content="Clear"/>
                            </ComboBox>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Bottom spacing" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="How far the expanded dock sits above the screen edge."
                                    Foreground="#A7B0BF"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                            <NumberBox
                                x:Name="BottomMarginBox"
                                Grid.Column="1"
                                Header="DIP"
                                Minimum="16"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="8"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Bottom spacing in device-independent pixels"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Auto-hide delay" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="Wait time before the expanded dock starts collapsing."
                                    Foreground="#A7B0BF"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                            <NumberBox
                                x:Name="AutoHideDelayBox"
                                Grid.Column="1"
                                Header="Seconds"
                                Minimum="0"
                                Maximum="10"
                                SmallChange="0.1"
                                LargeChange="1"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Auto-hide delay in seconds"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Peek delay" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="How long the raised indicator waits before lowering near the edge."
                                    Foreground="#A7B0BF"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                            <NumberBox
                                x:Name="PeekDelayBox"
                                Grid.Column="1"
                                Header="Seconds"
                                Minimum="0"
                                Maximum="30"
                                SmallChange="0.1"
                                LargeChange="1"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Peek delay in seconds"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="24,22"
                    CornerRadius="18"
                    Background="#C91A202B"
                    BorderBrush="#344052"
                    BorderThickness="1">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Appearance" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Tune the expanded dock while preserving its existing interaction and glass pipeline."
                                Foreground="#99A5B7"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon size" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="IconSizeBox" Grid.Column="1" Header="DIP" Minimum="20" Maximum="40"
                                SmallChange="1" LargeChange="4" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Dock icon size in device-independent pixels"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Magnification" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="MagnificationScaleBox" Grid.Column="1" Header="Scale" Minimum="1" Maximum="1.6"
                                SmallChange="0.05" LargeChange="0.1" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Maximum dock icon magnification scale"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon spacing" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="IconSpacingBox" Grid.Column="1" Header="DIP" Minimum="0" Maximum="20"
                                SmallChange="1" LargeChange="4" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Spacing between dock icons in device-independent pixels"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Glass blur" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="GlassBlurAmountBox" Grid.Column="1" Header="Amount" Minimum="0" Maximum="60"
                                SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Main dock glass blur amount"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dock opacity" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="DockOpacityBox" Grid.Column="1" Header="Percent" Minimum="35" Maximum="100"
                                SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Expanded dock glass opacity percentage"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Border thickness" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="BorderThicknessBox" Grid.Column="1" Header="DIP" Minimum="0" Maximum="2"
                                SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Expanded dock border thickness in device-independent pixels"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#293342"/>

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Border opacity" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <NumberBox x:Name="BorderOpacityBox" Grid.Column="1" Header="Percent" Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Expanded dock border opacity percentage"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Foreground="#9EABBC"
                        FontSize="12"
                        TextWrapping="Wrap"/>
                    <Button
                        Grid.Column="1"
                        Content="Reset to Defaults"
                        Click="ResetClick"
                        Padding="16,9"/>
                    <Button
                        x:Name="ApplyButton"
                        Grid.Column="2"
                        Content="Apply"
                        Click="ApplyClick"
                        Padding="22,9"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
